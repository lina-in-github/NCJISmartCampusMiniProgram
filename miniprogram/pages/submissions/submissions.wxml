<view class="app theme-{{theme}}">
  <view class="topbar">
    <view class="topbar-left">
      <view class="topbar-title">{{scope === 'mine' ? s.myTitle : s.title}}</view>
      <view class="topbar-sub">{{countText || ''}}{{ctx.classText ? ' · ' + ctx.classText : ''}}</view>
    </view>
    <view class="topbar-actions">
      <view class="icon-btn" wx:if="{{ctx.staff}}" bindtap="onPublish">{{s.publish}}</view>
      <view class="icon-btn {{showHiddens ? 'accent-text' : ''}}" bindtap="onToggleHiddens">{{showHiddens ? s.hideHiddens : s.showHiddens}}</view>
      <view class="icon-btn" bindtap="onToggleTheme">◐</view>
    </view>
  </view>

  <view class="tabs" wx:if="{{ctx.staff}}">
    <view class="tab {{scope === 'all' ? 'active' : ''}}" data-scope="all" bindtap="onScope">{{s.scopeAll}}</view>
    <view class="tab {{scope === 'mine' ? 'active' : ''}}" data-scope="mine" bindtap="onScope">{{s.scopeMine}}</view>
  </view>

  <view class="tabs" wx:if="{{scope === 'all' && tabs.length}}">
    <view class="tab {{activeTab ? '' : 'active'}}" data-tab="" bindtap="onTab">{{s.tabAll}}</view>
    <view class="tab {{item.active ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="name" data-tab="{{item.name}}" bindtap="onTab">{{item.displayName}}</view>
  </view>

  <view class="notice danger" wx:if="{{error}}">{{error}}</view>

  <view class="empty" wx:if="{{!loading && !rows.length}}">
    <view class="empty-title">{{scope === 'mine' ? s.myEmpty : s.title}}</view>
    <view class="empty-desc">{{scope === 'mine' ? s.myEmpty : s.emptyDesc}}</view>
    <view class="btn-row">
      <view class="btn primary" wx:if="{{ctx.staff}}" bindtap="onPublish">{{s.publishFirst}}</view>
    </view>
  </view>

  <view class="list">
    <view class="card" wx:for="{{rows}}" wx:key="id" data-index="{{index}}">
      <view bindtap="onOpen" data-index="{{index}}">
        <view class="flex-between">
          <view class="card-title">{{item.name}}</view>
          <view class="chip {{item.deadlineTone}}">{{item.deadlineText}}</view>
        </view>
        <view class="chip-row">
          <view class="chip">{{item.typeText}}</view>
          <view class="chip warn" wx:for="{{item.flagTexts}}" wx:key="*this" wx:for-item="flag">{{flag}}</view>
          <view class="chip pinned" wx:if="{{item.pinned}}">{{s.noticePinned}}</view>
          <view class="chip">{{item.countText}}</view>
          <view class="chip warn" wx:if="{{ctx.staff && item.pendingCount}}">{{item.pendingText}}</view>
        </view>
        <view class="card-desc" wx:if="{{item.descShort}}">{{item.descShort}}</view>
        <view class="card-foot">
          <view>{{item.createdBy}} · {{item.createdText}}</view>
          <view class="accent-text">{{item.actionText}}</view>
        </view>
      </view>
      <view class="btn-row" wx:if="{{ctx.role === 'admin'}}">
        <view class="btn small danger" data-index="{{index}}" catchtap="onDelete">{{s.delete}}</view>
      </view>
    </view>
  </view>

  <confirm-dialog
    open="{{dialog.open}}"
    title="{{dialog.title}}"
    message="{{dialog.message}}"
    object-label="{{dialog.objectLabel}}"
    object-info="{{dialog.objectInfo}}"
    need-password="{{dialog.needPassword}}"
    password-label="{{dialog.passwordLabel}}"
    password-placeholder="{{dialog.passwordPlaceholder}}"
    confirm-text="{{dialog.confirmText}}"
    cancel-text="{{dialog.cancelText}}"
    loading="{{dialog.loading}}"
    danger="{{dialog.danger}}"
    bind:confirm="onDialogConfirm"
    bind:cancel="onDialogCancel"
  />

  <bottom-nav active="submissions" />
</view>
